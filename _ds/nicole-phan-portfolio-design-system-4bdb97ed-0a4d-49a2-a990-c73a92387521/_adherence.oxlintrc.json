{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/layout/**",
              "components/reasoning/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter Tight|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter Tight, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotatedEvidence'] > JSXAttribute > JSXIdentifier[name!=/^(?:claim|annotations|children|key|ref|className|style|children)$/]",
        "message": "<AnnotatedEvidence> doesn't accept that prop. Declared props: claim, annotations, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|signalDot|href|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, signalDot, href, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseStudySection'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|label|title|lede|children|key|ref|className|style|children)$/]",
        "message": "<CaseStudySection> doesn't accept that prop. Declared props: number, label, title, lede, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|decision|why|tradeOff|evidence|key|ref|className|style|children)$/]",
        "message": "<DecisionCard> doesn't accept that prop. Declared props: index, decision, why, tradeOff, evidence."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|radius|active|tone|children|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: padding, radius, active, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:glass|solid|ink)$/]",
        "message": "<GlassCard> tone must be one of 'glass' | 'solid' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutcomeMetric'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|metric|context|tone|key|ref|className|style|children)$/]",
        "message": "<OutcomeMetric> doesn't accept that prop. Declared props: index, metric, context, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutcomeMetric'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|signal)$/]",
        "message": "<OutcomeMetric> tone must be one of 'plain' | 'signal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|transformation|tags|status|year|tone|href|artefact|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: number, title, transformation, tags, status, year, tone, href, artefact."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:glass|ink)$/]",
        "message": "<ProjectCard> tone must be one of 'glass' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TraceStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|active|key|ref|className|style|children)$/]",
        "message": "<TraceStep> doesn't accept that prop. Declared props: label, note, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|items|active|onNavigate|contactLabel|key|ref|className|style|children)$/]",
        "message": "<SiteNav> doesn't accept that prop. Declared props: mark, items, active, onNavigate, contactLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:shipped|signal|neutral)$/]",
        "message": "<StatusChip> tone must be one of 'shipped' | 'signal' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SurfaceRootProblem'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|root|key|ref|className|style|children)$/]",
        "message": "<SurfaceRootProblem> doesn't accept that prop. Declared props: surface, root."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowStage'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|value|active|key|ref|className|style|children)$/]",
        "message": "<FlowStage> doesn't accept that prop. Declared props: label, items, value, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThinkingTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|index|active|key|ref|className|style|children)$/]",
        "message": "<ThinkingTag> doesn't accept that prop. Declared props: label, index, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='TradeOffState'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|statement|context|action|key|ref|className|style|children)$/]",
        "message": "<TradeOffState> doesn't accept that prop. Declared props: index, statement, context, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnknownCheck'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|statement|chip|key|ref|className|style|children)$/]",
        "message": "<UnknownCheck> doesn't accept that prop. Declared props: index, statement, chip."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
